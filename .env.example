# ─── Microsoft Entra ID ──────────────────────────────────────────────
# Registra una aplicacion en Entra ID (SPA + redirect a tu dominio) y pega
# aqui los dos identificadores. Son obligatorios: sin ellos ni el servidor
# ni el frontend arrancan.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Los mismos valores, con el prefijo que Vite expone al navegador.
VITE_AZURE_TENANT_ID=
VITE_AZURE_CLIENT_ID=

# ─── Servidor ────────────────────────────────────────────────────────
# Puerto de escucha. Por defecto 3007.
PORT=3007

# Donde vive data.json. En produccion apunta a un volumen persistente,
# fuera del directorio de la aplicacion, para que un despliegue no lo pise.
DATA_DIR=

# Origenes permitidos por CORS, separados por comas. localhost ya esta
# incluido; aqui van los dominios de produccion.
ALLOWED_ORIGINS=https://tu-dominio.example

# ─── Notificaciones push (opcional) ──────────────────────────────────
# Genera el par con:  npx web-push generate-vapid-keys
# Sin las tres variables, los endpoints de push responden 503 y el resto
# del servidor funciona igual.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@example.com

# ─── Registro con Google (opcional) ──────────────────────────────────
# Quien entra con Google se registra como invitado de ESTE mismo directorio,
# asi que no hay segundo tenant ni segunda aplicacion. Solo hay que encender
# el boton, y solo cuando el directorio tenga el auto-registro configurado.
VITE_GOOGLE_ACTIVO=false

# Duenos del hogar migrado: correos u oid de las dos cuentas de la pareja,
# separados por comas. Sin esto nadie hereda esos datos, ni ellos mismos:
# falla cerrada a proposito, porque la alternativa es que los reclame quien
# llegue primero.
MIEMBROS_PRINCIPAL=

# Freno de mano, opcional. Con correos aqui, solo esos entran. Vacia, entra
# quien el directorio autorice, y cada quien estrena su hogar vacio: lo que
# separa los datos de unos y otros son los hogares, no esta lista.
ALLOWED_USERS=

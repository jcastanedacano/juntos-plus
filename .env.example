# ─── Microsoft Entra ID ──────────────────────────────────────────────
# Registra una aplicacion en Entra ID (SPA + redirect a tu dominio) y pega
# aqui los dos identificadores. Son obligatorios: sin ellos ni el servidor
# ni el frontend arrancan.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Los mismos valores, con el prefijo que Vite expone al navegador.
VITE_AZURE_TENANT_ID=
VITE_AZURE_CLIENT_ID=

# ─── Servidor ────────────────────────────────────────────────────────
# Puerto de escucha. Por defecto 3007.
PORT=3007

# Donde vive data.json. En produccion apunta a un volumen persistente,
# fuera del directorio de la aplicacion, para que un despliegue no lo pise.
DATA_DIR=

# Origenes permitidos por CORS, separados por comas. localhost ya esta
# incluido; aqui van los dominios de produccion.
ALLOWED_ORIGINS=https://tu-dominio.example

# ─── Notificaciones push (opcional) ──────────────────────────────────
# Genera el par con:  npx web-push generate-vapid-keys
# Sin las tres variables, los endpoints de push responden 503 y el resto
# del servidor funciona igual.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@example.com

# ─── Entra External ID (opcional) ────────────────────────────────────
# Segunda puerta de entrada, para cuentas que no estan en el directorio de
# trabajo: Google, correo suelto. Sin las tres variables el boton no aparece
# y la aplicacion se comporta como si no existiera.
# Correos u oid de las dos cuentas dueñas de los datos migrados.
# Sin esto nadie hereda ese hogar: falla cerrada a proposito.
MIEMBROS_PRINCIPAL=

EXTERNAL_TENANT_ID=
EXTERNAL_CLIENT_ID=
EXTERNAL_SUBDOMAIN=

VITE_EXTERNAL_TENANT_ID=
VITE_EXTERNAL_CLIENT_ID=
VITE_EXTERNAL_SUBDOMAIN=

# Quien puede entrar, correos separados por comas.
#
# Hasta ahora la lista era el tenant: solo las cuentas del directorio privado
# podian pedir un token. Un tenant externo con registro libre rompe eso, asi
# que los tokens externos EXIGEN estar en esta lista. Vacia significa que
# nadie entra por esa puerta, que es el unico valor por defecto seguro.
ALLOWED_USERS=
